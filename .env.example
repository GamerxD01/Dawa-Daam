# =====================================================================
# DawaDaam Environment Configuration
# =====================================================================

# ---------------------------------------------------------------------
# OpenStreetMap & Map Tile Provider Configuration
# ---------------------------------------------------------------------
# Tile server URL template:
# Default: https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Popular custom providers:
# - Stadia: https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}{r}.png?api_key={apiKey}
# - Thunderforest: https://tile.thunderforest.com/transport/{z}/{x}/{y}.png?apikey={apiKey}
# - Mapbox: https://api.mapbox.com/styles/v1/mapbox/streets-v11/tiles/{z}/{x}/{y}?access_token={apiKey}
# - Geoapify: https://maps.geoapify.com/v1/tile/osm-bright/{z}/{x}/{y}.png?apiKey={apiKey}
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Optional API key for your map provider (replaces {apiKey}, {key}, {accessToken} or appends ?api_key=...)
VITE_OSM_API_KEY=

# Optional custom attribution (HTML supported)
VITE_OSM_ATTRIBUTION=

# ---------------------------------------------------------------------
# Overpass API Endpoint (Jan Aushadhi Kendra Search)
# ---------------------------------------------------------------------
# Point to custom or self-hosted Overpass API instance if needed.
# Default public fallback: https://overpass-api.de/api/interpreter
VITE_OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# ---------------------------------------------------------------------
# Geocoding / Address Lookup (Optional)
# ---------------------------------------------------------------------
# Nominatim / LocationIQ / Geoapify
VITE_GEOCODING_API_URL=https://nominatim.openstreetmap.org/reverse
VITE_GEOCODING_API_KEY=

# ---------------------------------------------------------------------
# Google Maps (Optional)
# ---------------------------------------------------------------------
VITE_GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------
# AI Vision Bridge (Prescription scanning)
# ---------------------------------------------------------------------
# Gemma bridge backend URL (e.g. http://localhost:8000)
VITE_GEMMA_URL=
